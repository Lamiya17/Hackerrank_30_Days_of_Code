import java.util.*;

public class Main {

    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        int arr[][]= new int[6][6];
        int maxsum=Integer.MIN_VALUE;

        for(int i=0;i<6;i++){
            for(int j=0;j<6;j++){
                arr[i][j]=sc.nextInt();
            }}
            for(int i =0;i<=3;i++){
                for(int j=0;j<=3;j++){
                    int sum=0;

                    sum+=arr[i][j];
                    sum+=arr[i][j+1];
                    sum+=arr[i][j+2];

                    sum+=arr[i+1][j+1];

                    sum+=arr[i+2][j];
                    sum+=arr[i+2][j];
                    sum+=arr[i+2][j];

                    if(sum>maxsum){
                        maxsum=sum;
                    }
                }
            }
        System.out.println(maxsum);
    }}
