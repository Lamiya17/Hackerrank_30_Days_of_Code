    public static void main(String[] args) {
    Scanner sc= new Scanner(System.in);
    int T=sc.nextInt();
    Node root =null;

    while(T-->0){
        int data=sc.nextInt();
        root=Solution.insert(root,data);
    }
    int height=Solution.getheight(root);
        System.out.println(height);
    }}

