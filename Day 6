import java.util.*;
public class Main {

    public static void main(String[] args) {
    Scanner sc= new Scanner(System.in);
    int T =sc.nextInt();
    sc.nextLine();
    for (int t =0;t<T;t++){
        String s=sc.nextLine();
        String odd=" ";
        String even=" ";
        for(int i=0;i<s.length();i++){
            if(i%2==0){
                even=even+s.charAt(i);
            }
            else {
                odd=odd+s.charAt(i);
            }
        }
        System.out.println(even+" "+odd);
    }

    }}
